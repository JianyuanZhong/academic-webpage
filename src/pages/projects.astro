---
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { projects } from "@data/projects";
---

<BaseLayout title="Projects">
  <section>
    <p class="eyebrow">Projects</p>
    <h1>Systems for verifiable learning and efficient test-time scaling.</h1>
    <p class="lead">Two connected directions: build agents that learn from executable verification, and build diffusion language model systems that turn additional test-time compute into useful capability.</p>
  </section>

  <section class="section">
    <div class="grid two">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
